
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Patient
  Doctor
}

model User {
  id                            Int       @id @default(autoincrement())
  username                      String    @unique
  firstName                     String
  secondName                    String
  email                         String    @unique
  password                      String
  role                          UserRole  @default(Patient)
  emailVerificationToken        String?
  emailVerificationExpiresAt    DateTime?
  isEmailVerified               Boolean   @default(false)
  createdAt                     DateTime  @default(now())
  deletedAt                     DateTime?
  updatedAt                     DateTime  @updatedAt
  doctor                        Doctor?
  patient                       Patient?

  sentMessages                  ChatMessage[]

  googleAccessToken            String?
  googleRefreshToken           String?
  googleCalendarChannelId      String?
  googleCalendarResourceId     String?
  googleCalendarSyncToken      String?
  googleCalendarChannelExpiresAt BigInt?

  events                       CalendarEvent[]
  telegramChatId              String?       @unique
  stripeCustomerId            String?       @unique
  isPremium                   Boolean       @default(false)
}

model Doctor {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  licenceNumber   String?   @unique
  specialization  String?

  user            User      @relation(fields: [userId], references: [id])
  patients        Patient[]
}

model Patient {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  doctorId          Int?
  dateOfBirth       DateTime?
  dateOfDiagnosis   DateTime?
  address           String?
  caregiversNumbers String?
  phoneNumber       String?

  user              User      @relation(fields: [userId], references: [id])
  doctor            Doctor?   @relation(fields: [doctorId], references: [id])
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  threadUserId  Int
  senderId      Int
  senderRole    String
  content       String
  createdAt     DateTime @default(now())

  sender        User     @relation(fields: [senderId], references: [id])
}


enum CalendarCategory {
  medicine
  appointment
  mundane
}

model CalendarEvent {
  id                String   @id @default(uuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  googleEventId     String?
  seriesId          String?
  notifyBefore      Int      @default(30)
  category          CalendarCategory @default(appointment)
  repeatDaily       Boolean  @default(false)
  repeatUntil       DateTime?
  notificationSent  Boolean  @default(false)

  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
}