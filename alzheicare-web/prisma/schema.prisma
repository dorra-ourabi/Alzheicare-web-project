generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Patient
  Doctor
}

model User {
  id                         Int       @id @default(autoincrement())
  username                   String    @unique
  firstName                  String
  secondName                 String
  email                      String    @unique
  password                   String
  role                       UserRole  @default(Patient)
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?
  isEmailVerified            Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  deletedAt                  DateTime?
  updatedAt                  DateTime  @updatedAt
  doctor                     Doctor?
  patient                    Patient?

  sentMessages      ChatMessage[]
  messages          Message[]
  events            CalendarEvent[]
  notifications     Notification[]
  webhookEvents     WebhookEvent[]

  telegramChatId   String? @unique
  stripeCustomerId String? @unique
  isPremium        Boolean @default(false)

  googleAccessToken              String?
  googleRefreshToken             String?
  googleCalendarChannelId        String?
  googleCalendarResourceId       String?
  googleCalendarSyncToken        String?
  googleCalendarChannelExpiresAt BigInt?
}

model Doctor {
  id             Int     @id @default(autoincrement())
  userId         Int     @unique
  licenceNumber  String? @unique
  specialization String?

  user          User           @relation(fields: [userId], references: [id])
  patients      Patient[]
  invitations   Invitation[]
  conversations Conversation[]
}

model Patient {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  doctorId          Int?
  dateOfBirth       DateTime?
  dateOfDiagnosis   DateTime?
  address           String?
  caregiversNumbers String?
  phoneNumber       String?

  user          User           @relation(fields: [userId], references: [id])
  doctor        Doctor?        @relation(fields: [doctorId], references: [id])
  invitations   Invitation[]
  conversations Conversation[]
}

model ChatMessage {
  id           Int      @id @default(autoincrement())
  threadUserId Int
  senderId     Int
  senderRole   String
  content      String
  createdAt    DateTime @default(now())

  sender User @relation(fields: [senderId], references: [id])
}

enum CalendarCategory {
  medicine
  appointment
  mundane
}

model CalendarEvent {
  id                String   @id @default(uuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  googleEventId     String?
  seriesId          String?
  notifyBefore      Int      @default(30)
  category          CalendarCategory @default(appointment)
  repeatDaily       Boolean  @default(false)
  repeatUntil       DateTime?
  notificationSent  Boolean  @default(false)

  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
}

enum NotificationType {
  NEW_MESSAGE
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_REJECTED
  CALENDAR_REMINDER
  MEDICATION_DUE
  SYSTEM
}

model Notification {
  id            Int               @id @default(autoincrement())
  userId        Int
  type          NotificationType
  title         String
  body          String?
  isRead        Boolean           @default(false)
  referenceId   Int?
  referenceType String?
  createdAt     DateTime          @default(now())
  readAt        DateTime?

  user          User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
model Invitation {
  id          Int              @id @default(autoincrement())
  patientId   Int
  doctorId    Int?
  doctorEmail String?
  status      InvitationStatus @default(PENDING)
  message     String?
  token       String?          @unique
  sentAt      DateTime         @default(now())
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor? @relation(fields: [doctorId], references: [id])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Conversation {
  id            Int       @id @default(autoincrement())
  patientId     Int
  doctorId      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  patient  Patient   @relation(fields: [patientId], references: [id])
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
  messages Message[]

  @@unique([patientId, doctorId])
}

model Message {
  id             Int           @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  sentAt         DateTime      @default(now())
  readAt         DateTime?
  status         MessageStatus @default(SENT)
  attachmentUrl  String?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}
model WebhookEvent {
  id           Int             @id @default(autoincrement())
  userId       Int
  channel      WebhookChannel
  triggerType  WebhookTrigger
  recipient    String
  subject      String?
  payload      Json
  status       WebhookStatus   @default(PENDING)
  attemptCount Int             @default(0)
  lastAttemptAt DateTime?
  deliveredAt  DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())

  user         User            @relation(fields: [userId], references: [id])
}

enum WebhookChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum WebhookStatus {
  PENDING
  SENT
  FAILED
  RETRY
}

enum WebhookTrigger {
  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_REJECTED
  NEW_MESSAGE
  CALENDAR_REMINDER
  MEDICATION_DUE
}
