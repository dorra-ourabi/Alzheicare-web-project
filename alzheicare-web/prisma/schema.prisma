
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Patient
  Doctor
}

model User {
  id                            Int       @id @default(autoincrement())
  username                      String    @unique
  firstName                     String
  secondName                    String
  email                         String    @unique
  password                      String
  role                          UserRole  @default(Patient)
  emailVerificationToken        String?
  emailVerificationExpiresAt    DateTime?
  isEmailVerified               Boolean   @default(false)
  createdAt                     DateTime  @default(now())
  deletedAt                     DateTime?
  updatedAt                     DateTime  @updatedAt
  doctor                        Doctor?
  patient                       Patient?

  sentMessages                  ChatMessage[]
  messages                      Message[]

  telegramChatId              String?       @unique
  stripeCustomerId            String?       @unique
  isPremium                   Boolean       @default(false)

  googleAccessToken            String?
  googleRefreshToken           String?
  googleCalendarChannelId      String?
  googleCalendarResourceId     String?
  googleCalendarSyncToken      String?
  googleCalendarChannelExpiresAt BigInt?

  events                       CalendarEvent[]
}

model Doctor {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  licenceNumber   String?   @unique
  specialization  String?

  user            User      @relation(fields: [userId], references: [id])
  patients        Patient[]
  invitations     Invitation[]
  conversations   Conversation[]
}

model Patient {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  doctorId          Int?
  dateOfBirth       DateTime?
  dateOfDiagnosis   DateTime?
  address           String?
  caregiversNumbers String?
  phoneNumber       String?

  user              User      @relation(fields: [userId], references: [id])
  doctor            Doctor?   @relation(fields: [doctorId], references: [id])
  invitations       Invitation[]
  conversations     Conversation[]
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  threadUserId  Int
  senderId      Int
  senderRole    String
  content       String
  createdAt     DateTime @default(now())

  sender        User     @relation(fields: [senderId], references: [id])
}

model Invitation {
  id          Int              @id @default(autoincrement())
  patientId   Int
  doctorId    Int?
  doctorEmail String?
  status      InvitationStatus @default(PENDING)
  message     String?
  token       String?          @unique
  sentAt      DateTime         @default(now())
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  patient     Patient          @relation(fields: [patientId], references: [id])
  doctor      Doctor?          @relation(fields: [doctorId], references: [id])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Conversation {
  id            Int       @id @default(autoincrement())
  patientId     Int
  doctorId      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  patient       Patient   @relation(fields: [patientId], references: [id])
  doctor        Doctor    @relation(fields: [doctorId], references: [id])
  messages      Message[]

  @@unique([patientId, doctorId])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  sentAt         DateTime  @default(now())
  readAt         DateTime?
  status         MessageStatus @default(SENT)
  attachmentUrl  String?

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum CalendarCategory {
  medicine
  appointment
  mundane
}

model CalendarEvent {
  id                String   @id @default(uuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  googleEventId     String?
  seriesId          String?
  notifyBefore      Int      @default(30)
  category          CalendarCategory @default(appointment)
  repeatDaily       Boolean  @default(false)
  repeatUntil       DateTime?
  notificationSent  Boolean  @default(false)

  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
}
