
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Patient
  Doctor
}

model User {
  id                            Int       @id @default(autoincrement())
  username                      String    @unique
  firstName                     String
  secondName                    String
  email                         String    @unique
  password                      String
  role                          UserRole  @default(Patient)
  emailVerificationToken        String?
  emailVerificationExpiresAt    DateTime?
  isEmailVerified               Boolean   @default(false)
  createdAt                     DateTime  @default(now())
  deletedAt                     DateTime?
  updatedAt                     DateTime  @updatedAt
  doctor                        Doctor?
  patient                       Patient?

  sentMessages                  ChatMessage[]
}

model Doctor {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  licenceNumber   String?   @unique
  specialization  String?

  user            User      @relation(fields: [userId], references: [id])
  patients        Patient[]
}

model Patient {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  doctorId          Int?
  dateOfBirth       DateTime?
  dateOfDiagnosis   DateTime?
  address           String?
  caregiversNumbers String?
  phoneNumber       String?

  user              User      @relation(fields: [userId], references: [id])
  doctor            Doctor?   @relation(fields: [doctorId], references: [id])
  chronicDiseases   ChronicDisease[]
  medications       Medication[]
  allergies         Allergy[]
  dailyLogs         DailyLog[]
  moodEntries       MoodEntry[]
  behaviorEntries   BehaviorEntry[]
  weightRecords     WeightRecord[]
  sleepRecords      SleepRecord[]
}

enum ChronicDiseaseType {
  Hypertension
  Diabetes
  HeartDisease
  Stroke
  Other
}

model ChronicDisease {
  id                Int                 @id @default(autoincrement())
  patientId         Int
  diseaseType       ChronicDiseaseType
  diagnosisDate     DateTime
  notes             String?
  additionalDisease String?

  patient Patient @relation(fields: [patientId], references: [id])
}

model Medication {
  id         Int      @id @default(autoincrement())
  patientId  Int
  name       String
  dosage     String?
  startDate  DateTime
  endDate    DateTime?
  notes      String?

  patient Patient @relation(fields: [patientId], references: [id])
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  threadUserId  Int
  senderId      Int
  senderRole    String
  content       String
  createdAt     DateTime @default(now())

  sender        User     @relation(fields: [senderId], references: [id])
}

enum MoodLevel {
  sad
  anxious
  neutral
  good
  great
}

enum BehaviorType {
  aggressiveness
  withdrawal
  anxiety
  repetitive_acts
}

enum SleepQuality {
  Poor
  Fair
  Good
  Excellent
}

model Allergy {
  id        Int    @id @default(autoincrement())
  patientId Int
  name      String

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

model DailyLog {
  id        Int      @id @default(autoincrement())
  patientId Int
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  moodEntry       MoodEntry?
  weightRecord    WeightRecord?
  sleepRecord     SleepRecord?
  behaviorEntries BehaviorEntry[]

  @@unique([patientId, date])
  @@map("daily_logs")
}

model MoodEntry {
  id         Int       @id @default(autoincrement())
  patientId  Int
  dailyLogId Int?      @unique
  date       DateTime
  mood       MoodLevel
  notes      String?
  recordedAt DateTime  @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dailyLog DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  @@map("mood_entries")
}

model BehaviorEntry {
  id         Int          @id @default(autoincrement())
  patientId  Int
  dailyLogId Int?
  date       DateTime
  behavior   BehaviorType
  recordedAt DateTime     @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dailyLog DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  @@map("behavior_entries")
}

model WeightRecord {
  id         Int      @id @default(autoincrement())
  patientId  Int
  dailyLogId Int?     @unique
  date       DateTime
  weightKg   Float
  recordedAt DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dailyLog DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  @@map("weight_records")
}

model SleepRecord {
  id         Int          @id @default(autoincrement())
  patientId  Int
  dailyLogId Int?         @unique
  date       DateTime
  hoursSlept Float
  quality    SleepQuality
  bedTime    String?
  wakeTime   String?
  notes      String?
  recordedAt DateTime     @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dailyLog DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  @@map("sleep_records")
}