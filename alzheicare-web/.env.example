# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/alzheicare_db

# Auth (NestJS)
JWT_ACCESS_SECRET=dev_access_secret
JWT_REFRESH_SECRET=dev_refresh_secret

# AI Assistant → FastAPI bridge
AI_JWT_SECRET=dev_secret
AI_SERVICE_URL=http://127.0.0.1:8000
# AI_SERVICE_INTERNAL_KEY=your-internal-key

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=3000
FRONTEND_URL=http://localhost:5173

# Optional dev bypass (do not use in production)
# BYPASS_AUTH=true
# BYPASS_USER_ID=1
